{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/google/gemini-2.0-flash-001",
  "provider": {
    "openrouter": {
      "name": "OpenRouter (cloud gratuito)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "INCOLLA_QUI_LA_TUA_KEY_OPENROUTER"
      },
      "models": {
        "google/gemini-2.0-flash-001": {
          "name": "Gemini 2.0 Flash — PRINCIPALE (gratis, 1M contesto)",
          "limit": { "context": 1000000, "output": 8192 }
        },
        "meta-llama/llama-3.3-70b-instruct": {
          "name": "Llama 3.3 70B — ragionamento avanzato (gratis)",
          "limit": { "context": 128000, "output": 8192 }
        },
        "deepseek/deepseek-r1-0528:free": {
          "name": "DeepSeek R1 — coding e logica (gratis)",
          "limit": { "context": 64000, "output": 8192 }
        },
        "anthropic/claude-sonnet-4-5": {
          "name": "Claude Sonnet 4.5 — massima qualita (a pagamento)",
          "limit": { "context": 200000, "output": 8192 }
        }
      }
    }
  }
}
